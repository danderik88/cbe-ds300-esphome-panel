# Copy to secrets.yaml (gitignored) and fill in.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
wifi_ap_password: "fallback-ap-password"
api_key: "base64-32-byte-key"   # `openssl rand -base64 32`
ota_password: "ota-password"
utenze_pin: "123456"            # 6-digit PIN asked on screen before switching the 12V loads
ha_url: "http://homeassistant.local:8123"  # used to fetch the media player cover art
